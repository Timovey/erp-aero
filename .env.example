NODE_ENV=development
PORT=4000
HOST=localhost
# Секрет подписи refresh-токенов (HS256), случайная строка не короче 32 символов
JWT_PRIVATE_KEY=change-me-refresh-secret-at-least-32-chars
# Секрет подписи access-токенов (HS256), случайная строка не короче 32 символов
JWT_PUBLIC_KEY=change-me-access-secret-at-least-32-chars
DB_NAME="erp-aero"
DB_USER="root"
DB_PSD="timovey"